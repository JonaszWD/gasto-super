# Copy to .env for local development. In production these live in Vercel project settings
# (web app) and GitHub Actions secrets (collectors, migrations). Never commit real values.

# --- Database (any Postgres; nothing Neon-specific) ---
# Local Docker:      postgresql+psycopg://gasto:gasto@localhost:5433/gasto
# Vercel (web app):  Neon *pooled* URL   (host contains "-pooler")
# Collectors/CI:     Neon *direct* URL   (host without "-pooler")
# postgres:// and postgresql:// URLs are accepted too; sslmode=require is kept as given.
DATABASE_URL=postgresql+psycopg://gasto:gasto@localhost:5433/gasto

# --- Login (single user) ---
# Generate with: uv run python -m app.tools.hash_password
APP_PASSWORD_HASH=
# At least 32 random characters: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Keep true in production (HTTPS). docker-compose sets false for http://localhost.
COOKIE_SECURE=true
SESSION_MAX_AGE_DAYS=400

# --- Optional ---
# Extra CORS origins, comma-separated (not needed: UI and API share one origin).
ALLOWED_ORIGINS=
# Open Food Facts asks for "AppName/Version (contact)".
OFF_USER_AGENT=GastoSuper/0.1 (personal spending tracker)
# User-Agent for supermarket price sources (collectors + "refresh now").
SOURCES_USER_AGENT=GastoSuper/0.1 (personal price comparison)
TIMEZONE=Europe/Madrid
DEFAULT_POSTAL_CODE=28020
